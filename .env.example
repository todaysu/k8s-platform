LISTEN_ADDR=:8080
# 独立指标监听地址；留空关闭。生产只在内网暴露。
METRICS_ADDR=
DATABASE_PATH=./data/platform.db
# Kubernetes/生产环境设置后，集群、容量、事件、账号和会话统一使用 MySQL；不设置则使用 SQLite。
PLATFORM_DATABASE_DSN=
# 也可直接提供 MySQL 连接字段，平台会生成 DSN；设置后跳过初始化页。
PLATFORM_DB_HOST=
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=
PLATFORM_DB_PASSWORD=
PLATFORM_DB_NAME=
PLATFORM_DB_TLS=
# 首次部署进入平台初始化页时使用；集群内运行才支持 setup 模式。
SETUP_MODE=false
SETUP_TOKEN=
SETUP_RUNTIME_SECRET=ftc-platform-runtime
SETUP_DEFAULT_DB_HOST=platform-mysql.ftc-platform.svc
SETUP_DEFAULT_DB_NAME=ftc_platform
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SECURE_COOKIES=false
SESSION_TTL=8h
# 统一的平台组件命名空间，逗号分隔；其他命名空间按业务资源统计。
SYSTEM_NAMESPACES=kube-system,cmb-monitoring
# 多集群健康快照：60+ 集群建议先使用以下默认值，再按 API Server 承载能力调优。
HEALTH_COLLECTION_INTERVAL=1m
HEALTH_COLLECTION_TIMEOUT=20s
HEALTH_COLLECTION_WORKERS=5
# pods: 统计全部 Pod；workloads: 统计 Deployment/StatefulSet/DaemonSet 副本，只列 kube-system Pod。
HEALTH_INSTANCE_SOURCE=pods
CAPACITY_COLLECTION_INTERVAL=5m
CAPACITY_COLLECTION_TIMEOUT=45s
CAPACITY_COLLECTION_WORKERS=3
# 跨集群搜索索引：Leader 每 10 分钟刷新一轮，浏览器搜索不再访问目标集群。
RESOURCE_INDEX_INTERVAL=10m
RESOURCE_INDEX_TIMEOUT=30s
RESOURCE_INDEX_WORKERS=2
LEADER_ELECTION_ENABLED=true
LEADER_ELECTION_NAME=ftc-platform-collectors
# 手动安全扫描：后台同时执行的集群数量。
SECURITY_SCAN_WORKERS=2
SECURITY_SCAN_TIMEOUT=30m
# 扫描 Pod 从 Job 创建到进入 Running 的最长等待时间；超时后扫描立即失败并回收临时资源。
SECURITY_POD_STARTUP_TIMEOUT=5m
SECURITY_KUBE_BENCH_IMAGE=docker.io/aquasec/kube-bench:v0.16.0
# 内部仓库如果是两个单架构镜像，分别配置；留空则回退到上面的多架构镜像。
SECURITY_KUBE_BENCH_IMAGE_AMD64=
SECURITY_KUBE_BENCH_IMAGE_ARM64=
SECURITY_HOST_SCAN_WORKERS=5
# kube-bench 临时 Job 所在命名空间。
SECURITY_SCANNER_NAMESPACE=kube-system
# 私有仓库可设置目标集群中已存在的同名 docker-registry Secret；留空表示不使用。
SECURITY_SCANNER_IMAGE_PULL_SECRET=

# Runtime isolation: all (local/default), api, collector, worker. Split roles require shared MySQL.
# api enqueues security scans; worker/all executes durable jobs using shared MySQL.
PLATFORM_ROLE=all
# PER PROCESS admission limits; multiply by API replicas to calculate deployment budget.
HTTP_QUERY_CONCURRENCY=64
HTTP_REALTIME_CONCURRENCY=20
HTTP_MONITORING_CONCURRENCY=8
HTTP_SESSION_CONCURRENCY=10
HTTP_CLUSTER_CONCURRENCY=2

# Fixed collector mapping; 0 = legacy single leader. Split collectors use shared MySQL.
# Once persisted, changing shard count requires a controlled migration (stop all collectors).
COLLECTION_SHARDS=0
