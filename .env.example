LISTEN_ADDR=:8080
DATABASE_PATH=./data/platform.db
# Kubernetes/生产环境设置后，集群、容量、事件、账号和会话统一使用 MySQL；不设置则使用 SQLite。
PLATFORM_DATABASE_DSN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SECURE_COOKIES=false
SESSION_TTL=8h
# 统一的平台组件命名空间，逗号分隔；其他命名空间按业务资源统计。
SYSTEM_NAMESPACES=kube-system,cmb-monitoring
# 多集群健康快照：60+ 集群建议先使用以下默认值，再按 API Server 承载能力调优。
HEALTH_COLLECTION_INTERVAL=1m
HEALTH_COLLECTION_TIMEOUT=20s
HEALTH_COLLECTION_WORKERS=5
CAPACITY_COLLECTION_INTERVAL=5m
CAPACITY_COLLECTION_TIMEOUT=45s
CAPACITY_COLLECTION_WORKERS=3
LEADER_ELECTION_ENABLED=true
LEADER_ELECTION_NAME=ftc-platform-collectors
